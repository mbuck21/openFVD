# Shell scripts must keep LF line endings or bash cannot run them on Windows.
*.sh text eol=lf
*.cmd text eol=crlf

# The baseline files are compared byte for byte; never convert them.
samples/baseline/*.fvd binary
samples/baseline/*.nlelem binary
samples/baseline/*.nl2elem -text

# The investigation projects are binary too.
samples/investigations/*.fvd binary

# The import samples and their references are compared byte for byte; never convert them.
samples/import/** -text

# The NoLimits 2 session kit is regenerated and compared byte for byte; never convert the generated files.
samples/nl2-session/*.fvd binary
samples/nl2-session/*.nl2elem -text
samples/nl2-session/predictions.* -text
